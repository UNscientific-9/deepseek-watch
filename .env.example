# 复制为 .env 后填写；不要把真实值提交到仓库。

# 可选：API 指纹 / 余额探测
DEEPSEEK_API_KEY=

# 可选：邮件通知
SMTP_USER=
SMTP_PASS=
SMTP_HOST=

# 可选：模型网关（OpenAI 兼容）
WEBWATCH_LLM_URL=
WEBWATCH_LLM_MODEL=

# 站点写入
INGEST_URL=
INGEST_TOKEN=
SITE_URL=

# 可选：QQ 播报（NapCat / OneBot v11）
QQ_NOTIFY_ENABLED=0
QQ_NOTIFY_GROUPS=
QQ_NOTIFY_WS=ws://127.0.0.1:3001
QQ_NOTIFY_BOT_ID=
QQ_NOTIFY_TOKEN=
