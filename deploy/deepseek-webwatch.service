[Unit]
Description=DeepSeek Web Watch（自建网页 + 模型指纹巡检）
Wants=network-online.target
After=network-online.target
# 巡检成功结束后立刻触发一次网站推送，避免邮件已到、网页还要等下一个 5 分钟定时器。
OnSuccess=deepseek-watch-push.service

[Service]
Type=oneshot
WorkingDirectory=/opt/deepseek-webwatch
EnvironmentFile=/opt/deepseek-webwatch/env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=TZ=Asia/Shanghai
ExecStart=/usr/bin/python3 -m webwatch.run
# 抓取阶段自带 240s 预算，到点会主动停止并落盘；这里留出 AI 判读和发信的余量。
TimeoutStartSec=600
Nice=10
IOSchedulingClass=idle
UMask=0077

# 沙箱：专用动态用户 + 只读系统 + 私有 /tmp + 无特权
DynamicUser=yes
StateDirectory=deepseek-webwatch
StateDirectoryMode=0750
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=512M
TasksMax=64
